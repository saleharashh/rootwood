{
  "name": "rootwood group",
  "version": "0.1.0",
  "private": true,
  "description": "Rootwood Group — Atelier Wood Shop E-commerce (Vite Static Frontend + Hardened PHP/MySQL API)",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "dev:php": "php -S 127.0.0.1:8000 -t backend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "build": "pnpm --filter web build",
    "build:web": "pnpm --filter web build",
    "typecheck": "pnpm --filter web typecheck",
    "preview": "pnpm --filter web preview",
    "dev:api": "pnpm --filter api start:dev",
    "build:api": "pnpm --filter api build",
    "test:api": "pnpm --filter api test --runInBand"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
