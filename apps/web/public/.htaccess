<IfModule mod_dir.c>
  # Keep canonical URLs slash-free: serve dir/index.html internally instead
  # of redirecting /products/slug to /products/slug/.
  DirectorySlash Off
  DirectoryIndex index.html index.php
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not rewrite /api requests so backend handles them
  RewriteCond %{REQUEST_URI} ^/api [NC]
  RewriteRule ^ - [L]

  # Dynamic sitemap generated by the PHP backend
  RewriteRule ^sitemap\.xml$ api/sitemap.php [L]

  # Pre-rendered SEO shells: /products/<slug>/index.html, /blog/<slug>/index.html
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]

  # If the requested file exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Fallback to index.html for SPA client-side routing
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>
