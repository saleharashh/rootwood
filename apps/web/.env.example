# Environment variables for the Next.js storefront.
# Copy to `.env.local` for development and configure the same keys on the
# production host.

# Public API origin used by the browser. Leave as "/api" to use the same-origin
# rewrite below, or set an absolute URL when the API lives on another domain.
NEXT_PUBLIC_API_URL="/api"

# Server-side API origin used by React Server Components. When it is not set,
# the server falls back to NEXT_PUBLIC_API_URL (if absolute) or
# http://127.0.0.1:3001.
API_URL="http://127.0.0.1:3001"

# When the browser uses "/api", Next.js proxies those requests here.
API_PROXY_TARGET="http://127.0.0.1:3001"

# Canonical public origin of this storefront, used for metadata, robots,
# sitemap and payment callbacks.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
