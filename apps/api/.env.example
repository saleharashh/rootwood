# Copy to `.env` and adjust for your machine.
DATABASE_URL="postgresql://postgres:admin@127.0.0.1:5432/rootwood?schema=public"

PORT=3001
NODE_ENV=development

# Required: generate a random secret with at least 32 characters.
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="1d"

# Optional dedicated secret for OTP digests. Falls back to JWT_SECRET.
OTP_SECRET=""

# Comma-separated list of allowed browser origins.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Public site origin for payment callbacks and links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Kavenegar SMS Gateway
# Leave empty to log messages to the console in development. In production an
# unconfigured SMS/email channel makes OTP login fail loudly instead of leaking
# the code in the API response.
KAVENEGAR_API_KEY=""
KAVENEGAR_SENDER=""
KAVENEGAR_TEMPLATE_VERIFY="craftedroot-verify"
KAVENEGAR_TEMPLATE_ORDER_CONFIRM="craftedroot-order-confirm"
KAVENEGAR_TEMPLATE_ORDER_STATUS="craftedroot-order-status"

# Transactional email (Resend). Required for email OTP in production.
RESEND_API_KEY=""
MAIL_FROM=""
MAIL_REPLY_TO=""

# Payment gateways (Zarinpal & Zibal). Amounts are converted from Toman to Rial
# once, inside the API, when a gateway request is made.
# In production both gateways must be configured with live credentials; the API
# refuses to mark orders paid otherwise.
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="true"
ZIBAL_MERCHANT=""
ZIBAL_SANDBOX="true"

# Development-only payment simulator. Ignored when NODE_ENV=production.
PAYMENT_SIMULATION="false"

# Cancels abandoned unpaid orders and releases their reserved stock. Enabled by
# default in production; set to "false" to disable or "true" to run it locally.
ORDER_EXPIRY_ENABLED="false"
ORDER_EXPIRY_HOURS="24"
ORDER_EXPIRY_INTERVAL_MS="900000"

# Demo seed. On localhost the password defaults to "CraftedRoot!2026".
# Set both values explicitly to seed a deployed demo database.
# SEED_DEMO_PASSWORD="choose-a-strong-demo-password"
# SEED_ALLOW_PRODUCTION="true"
