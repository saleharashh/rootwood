# Rootwood Group — PHP Backend Environment Variables

APP_ENV=production
SITE_URL=https://rootwoodgroup.ir
API_URL=https://rootwoodgroup.ir/api

# Database (MySQL 8.0 / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rootwood
DB_USER=root
DB_PASS=secret

# Security & JWT
JWT_SECRET=replace-with-a-very-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=86400
OTP_SECRET=replace-with-a-random-secret-for-otp-hashing
# Comma-separated mobile numbers that get the ADMIN role on OTP login
ADMIN_PHONES=09131534532,09134398431
# Temporary manager login with the admin phones above (until the SMS panel is connected).
# Leave ADMIN_PASSWORD empty to disable password login and require OTP only.
# ADMIN_PASSWORD_HASH (bcrypt) takes precedence when set; generate it with:
#   php -r "echo password_hash('your-password', PASSWORD_BCRYPT), PHP_EOL;"
ADMIN_PASSWORD=R@@tw@@d5432
ADMIN_PASSWORD_HASH=

# Gateways
PAYMENT_SIMULATION=false
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
ZIBAL_MERCHANT=
ZIBAL_SANDBOX=false

# Notifications (SMS.ir panel → Developers → API keys, template from "ارسال سریع")
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=
# نام پارامتر کد در قالب پیامک (مثلاً CODE)
SMS_IR_OTP_PARAMETER=CODE
RESEND_API_KEY=
MAIL_FROM=orders@rootwoodgroup.ir

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=https://rootwoodgroup.ir,http://localhost:5173
