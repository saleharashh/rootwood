# Rootwood Group — PHP Backend Environment Variables

APP_ENV=production
SITE_URL=https://rootwoodgroup.ir
API_URL=https://rootwoodgroup.ir/api

# Database (MySQL 8.0 / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rootwood
DB_USER=root
DB_PASS=secret

# Security & JWT
JWT_SECRET=replace-with-a-very-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=86400
OTP_SECRET=replace-with-a-random-secret-for-otp-hashing

# Gateways
PAYMENT_SIMULATION=false
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
ZIBAL_MERCHANT=
ZIBAL_SANDBOX=false

# Notifications
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
RESEND_API_KEY=
MAIL_FROM=orders@rootwoodgroup.ir

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=https://rootwoodgroup.ir,http://localhost:5173
